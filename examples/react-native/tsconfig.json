{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "customConditions": ["react-native"],
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@hraness/direct": ["../../src/index.ts"],
      "@hraness/direct/core": ["../../src/core/index.ts"],
      "@hraness/direct/react": ["../../src/react.ts"],
      "@hraness/direct/testing": ["../../src/testing/index.ts"],
      "@hraness/direct/web": ["../../src/web.ts"]
    },
    "types": ["bun", "react", "react-native"]
  },
  "include": [
    "index.ts",
    "metro.config.cjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "direct/**/*.ts",
    "direct/**/*.tsx",
    "verify.ts"
  ]
}
